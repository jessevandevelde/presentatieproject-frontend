{
  "name": "roc-kompas-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Angular frontend voor ROC Kompas van ROC Midden Nederland",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "eslint": "ng lint",
    "eslint:fix": "ng lint --fix",
    "stylelint": "stylelint \"src/**/*.css\" -c ./stylelint.config.mjs",
    "stylelint:fix": "npm run stylelint -- --fix",
    "lint": "npm run eslint && npm run stylelint"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@angular/animations": "^20.2.4",
    "@angular/common": "^20.2.4",
    "@angular/compiler": "^20.2.4",
    "@angular/core": "^20.2.4",
    "@angular/forms": "^20.2.4",
    "@angular/platform-browser": "^20.2.4",
    "@angular/router": "^20.2.4",
    "@ngrx/effects": "^20.0.1",
    "@ngrx/store": "^20.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.4",
    "@eslint/js": "^9.35.0",
    "@ngrx/store-devtools": "^20.0.1",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@stylistic/stylelint-config": "^3.0.1",
    "@stylistic/stylelint-plugin": "^4.0.0",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "20.2.0",
    "eslint": "^9.35.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "stylelint": "^16.24.0",
    "stylelint-config-recommended": "^17.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.43.0"
  }
}
